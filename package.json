{
  "name": "oh-my-md-viewer",
  "productName": "OMMV",
  "version": "1.0.0",
  "description": "OMMV (oh-my-md-viewer) — Windows용 Markdown 뷰어",
  "main": "main.js",
  "author": {
    "name": "demolabskr",
    "email": "demolabskr@proton.me"
  },
  "license": "MIT",
  "homepage": "https://github.com/demolabskr/oh-my-md-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demolabskr/oh-my-md-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/demolabskr/oh-my-md-viewer/issues"
  },
  "keywords": [
    "markdown",
    "viewer",
    "windows",
    "electron",
    "mermaid",
    "katex"
  ],
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "pnpm run build:web && electron .",
    "pack": "pnpm run build:web && electron-builder --win --dir",
    "dist": "pnpm run build:web && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.github.demolabskr.ommv",
    "productName": "OMMV",
    "artifactName": "OMMV-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OMMV",
      "language": "1042"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "build/icon.ico",
        "role": "Viewer"
      }
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "copyright": "Copyright © 2026 demolabskr"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.16",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.1.0"
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228",
  "pnpm": {
    "overrides": {
      "katex": "^0.19.0"
    }
  }
}
